<style>
  html, body {
    margin: 0;
    padding: 0;
    background: black; /* żeby przy braku obrazu nie było białego tła */
  }
  .video-wrap {
    position: relative;
    width: 100%;
    height: 100vh; /* pełna wysokość okna przeglądarki */
    margin: 0;
    padding: 0;
    overflow: hidden;
  }
  .video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>

<div class="video-wrap">
  <iframe
    src="https://fluxplay.xyz/live/weeb.php?id=hbo_3_3"
    allowfullscreen
    loading="lazy">
  </iframe>
</div>
<script>
        document.addEventListener('contextmenu', (e) => {
            e.preventDefault();
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'F12' || 
                (e.ctrlKey && e.shiftKey && (e.key === 'I' || e.key === 'i' || e.key === 'J' || e.key === 'j')) ||
                (e.ctrlKey && (e.key === 'U' || e.key === 'u' || e.key === 'S' || e.key === 's'))) {
                e.preventDefault();
            }
        });
    </script>
