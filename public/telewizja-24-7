  <style>
    body {
      margin: 0;
      font-family: "Segoe UI", Arial, sans-serif;
      display: flex;
      height: 100vh;
      background: #0a0a0f;
      color: #fff;
    }
    /* Sidebar */
    .sidebar {
      width: 260px;
      background: #000;
      padding: 20px;
      box-shadow: 4px 0 20px rgba(0,255,204,0.25);
      overflow-y: auto;
    }
    .sidebar h2 {
      margin: 20px 0 10px;
      font-size: 1.2em;
      color: #00ffcc;
      text-shadow: 0 0 12px #00ffcc, 0 0 24px #ff00d4;
      border-bottom: 1px solid rgba(0,255,204,0.3);
      padding-bottom: 6px;
    }
    /* Buttons */
    .channel-btn {
      display: block;
      width: 100%;
      margin: 6px 0;
      padding: 10px;
      font-size: 0.95em;
      font-weight: bold;
      color: #00ffcc;
      background: transparent;
      border: 1px solid #00ffcc;
      border-radius: 6px;
      cursor: pointer;
      text-align: left;
      text-shadow: 0 0 6px #00ffcc;
      transition: all 0.3s ease;
    }
    .channel-btn:hover {
      background: #00ffcc;
      color: #000;
      box-shadow: 0 0 20px #00ffcc, 0 0 40px #ff00d4;
      transform: translateX(5px);
    }
    /* Neonowy przycisk powrotu */
    .home-btn {
      display: block;
      width: 100%;
      margin: 0 0 20px;
      padding: 12px;
      font-size: 1em;
      font-weight: bold;
      color: #00ff66; /* neonowa zieleń */
      background: transparent;
      border: 2px solid #00ff66;
      border-radius: 8px;
      cursor: pointer;
      text-align: center;
      text-shadow: 0 0 8px #00ff66;
      transition: all 0.3s ease;
    }
    .home-btn:hover {
      background: #00ff66;
      color: #000;
      box-shadow: 0 0 20px #00ff66, 0 0 40px #00ffcc;
      transform: scale(1.05);
    }
    /* Neonowa wyszukiwarka (pod przyciskiem) */
    .search-box {
      width: 90%;
      height: 32px;
      padding: 10px 14px;
      margin-bottom: 15px;
      font-size: 1.1em;
      color: #00ffcc;
      background: #111;
      border: 2px solid #00ffcc;
      border-radius: 8px;
      outline: none;
      text-shadow: 0 0 8px #00ffcc;
      box-shadow: 0 0 12px rgba(0,255,204,0.4);
      transition: all 0.3s ease;
    }
    .search-box::placeholder {
      color: #00ffcc;
      opacity: 0.7;
      text-shadow: 0 0 6px #00ffcc;
    }
    .search-box:focus {
      background: #000;
      box-shadow: 0 0 20px #00ffcc, 0 0 40px #ff00d4;
      transform: scale(1.03);
    }
    /* Content */
    .content {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #111;
      position: relative;
    }
    #player {
      width: 90%;
      height: 90%;
      border: none;
      border-radius: 12px;
      box-shadow: 0 0 25px rgba(0,255,204,0.4), 0 0 45px rgba(255,0,212,0.25);
      display: none;
      background: #000;
    }
    .placeholder {
      font-size: 1.4em;
      color: #888;
      text-shadow: 0 0 10px rgba(0,255,204,0.3);
    }
  </style>
  
