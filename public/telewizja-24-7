  <script>
  const player = document.getElementById("player");
  const placeholder = document.querySelector(".placeholder");

  // Obsługa kliknięcia w kanał
  document.querySelectorAll(".channel-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const url = btn.getAttribute("data-embed");
      player.src = url;
      player.style.display = "block";
      placeholder.style.display = "none";
    });
  });

  // Wyszukiwarka kanałów
  const searchInput = document.getElementById("searchInput");
  const allChannels = document.querySelectorAll(".channel-btn");
  const allHeadings = document.querySelectorAll(".sidebar h2");

  searchInput.addEventListener("keyup", () => {
    const filter = searchInput.value.toLowerCase();

    // filtrowanie kanałów
    allChannels.forEach(btn => {
      const txt = btn.textContent.toLowerCase();
      btn.style.display = txt.includes(filter) ? "block" : "none";
    });

    // ukrywanie nagłówków, gdy coś wpisane
    if (filter.length > 0) {
      allHeadings.forEach(h => h.style.display = "none");
    } else {
      allHeadings.forEach(h => h.style.display = "block");
    }
  });
  
 
</script>
